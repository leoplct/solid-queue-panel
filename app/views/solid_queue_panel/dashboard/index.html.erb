<% content_for :title, "Dashboard" %>

<div class="space-y-4">
  <% if @health.any? %>
    <div class="space-y-2">
      <% @health.alerts.each do |alert| %>
        <div class="flex items-start gap-2 rounded-lg px-4 py-3 text-sm ring-1 ring-inset <%= alert_classes(alert.level) %>">
          <%= icon alert_icon(alert.level), css_class: "size-5 shrink-0" %>
          <span><%= alert.message %></span>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="<%= card_classes %>">
    <div class="<%= card_header_classes %>">
      <div>
        <h2 class="text-sm font-semibold">Capacity</h2>
        <p class="mt-0.5 text-xs text-slate-500">
          Threads polling each queue, what they are running right now, and how long the rest will take.
          <% if @capacity.durations_source == :estimated %>
            Durations are estimated from enqueue to completion, so they read long:
            <%= link_to "install the resource metrics", resources_path, class: "underline underline-offset-2" %>
            to measure how long jobs actually run.
          <% end %>
        </p>
      </div>

      <p class="text-xs text-slate-500">
        <%= number @capacity.total_capacity %> worker <%= "thread".pluralize(@capacity.total_capacity) %> in total
      </p>
    </div>

    <% if @capacity.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800">
          <thead class="bg-slate-50 dark:bg-slate-900/60">
            <tr>
              <th scope="col" class="<%= table_header_classes %>">Queue</th>
              <th scope="col" class="<%= table_header_classes %> text-right">Capacity</th>
              <th scope="col" class="<%= table_header_classes %>">In progress</th>
              <th scope="col" class="<%= table_header_classes %> text-right">Pending</th>
              <th scope="col" class="<%= table_header_classes %>">Last added</th>
              <th scope="col" class="<%= table_header_classes %> text-right">ETA</th>
              <th scope="col" class="<%= table_header_classes %> text-right" title="Jobs that raised an error and are waiting to run again">Retries</th>
              <th scope="col" class="<%= table_header_classes %> text-right" title="Jobs waiting for their scheduled time">Scheduled</th>
              <th scope="col" class="<%= table_header_classes %> text-right" title="Jobs that failed and will not be retried until you say so">Dead</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-100 dark:divide-slate-800/70">
            <% @capacity.rows.each do |row| %>
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
                <td class="px-4 py-2.5">
                  <%= link_to row.name, queue_path(row.name), class: "text-sm font-medium hover:underline" %>
                  <% if row.paused? %>
                    <%= badge "paused", color: "amber", icon_name: "pause" %>
                  <% end %>
                </td>

                <td class="<%= table_cell_classes %> text-right tabular-nums"
                    title="Threads of every worker polling this queue. A worker polling several queues lends its threads to all of them.">
                  <%= number row.capacity %>
                </td>

                <td class="px-4 py-2.5"><%= utilization_bar row.in_progress, row.capacity %></td>

                <td class="<%= table_cell_classes %> text-right tabular-nums <%= "font-semibold" if row.pending.positive? %>">
                  <%= number row.pending %>
                </td>

                <td class="<%= table_cell_classes %>"><%= relative_time row.last_enqueued_at %></td>

                <td class="<%= table_cell_classes %> text-right tabular-nums">
                  <% if row.idle? %>
                    <span class="text-slate-400">empty</span>
                  <% elsif row.paused? %>
                    <span class="text-amber-600 dark:text-amber-400" title="A paused queue is not being worked on">paused</span>
                  <% elsif row.capacity.zero? %>
                    <span class="text-rose-600 dark:text-rose-400" title="No worker is polling this queue">never</span>
                  <% else %>
                    <span title="<%= pluralize row.backlog, "job" %> to run, spread over <%= pluralize row.capacity, "thread" %>">
                      <%= duration_in_words row.eta_seconds %>
                    </span>
                  <% end %>
                </td>

                <td class="<%= table_cell_classes %> text-right tabular-nums">
                  <% if row.retries.positive? %>
                    <%= link_to number(row.retries), jobs_path(status: "scheduled", queue_name: row.name),
                                class: "text-amber-600 hover:underline dark:text-amber-400" %>
                  <% else %>
                    <span class="text-slate-400">0</span>
                  <% end %>
                </td>

                <td class="<%= table_cell_classes %> text-right tabular-nums">
                  <% if row.scheduled.positive? %>
                    <%= link_to number(row.scheduled), jobs_path(status: "scheduled", queue_name: row.name), class: "hover:underline" %>
                  <% else %>
                    <span class="text-slate-400">0</span>
                  <% end %>
                </td>

                <td class="<%= table_cell_classes %> text-right tabular-nums">
                  <% if row.dead.positive? %>
                    <%= link_to number(row.dead), jobs_path(status: "failed", queue_name: row.name),
                                class: "font-semibold text-rose-600 hover:underline dark:text-rose-400" %>
                  <% else %>
                    <span class="text-slate-400">0</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= render "solid_queue_panel/shared/empty_state",
                 title: "No queue yet",
                 description: "Queues show up here as soon as a job is enqueued or a worker starts polling them.",
                 icon_name: "queue-list" %>
    <% end %>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="<%= card_classes %>">
      <div class="<%= card_header_classes %>">
        <h2 class="text-sm font-semibold">Processes</h2>
        <%= link_to "All processes", processes_path, class: "text-sm text-slate-500 underline-offset-2 hover:underline" %>
      </div>

      <div class="grid grid-cols-2 gap-px bg-slate-200 sm:grid-cols-4 dark:bg-slate-800">
        <div class="bg-white p-4 dark:bg-slate-900">
          <div class="text-xs uppercase tracking-wide text-slate-500">Processes</div>
          <div class="mt-1 text-xl font-semibold tabular-nums"><%= number @registry.processes.size %></div>
        </div>
        <div class="bg-white p-4 dark:bg-slate-900">
          <div class="text-xs uppercase tracking-wide text-slate-500">Threads</div>
          <div class="mt-1 text-xl font-semibold tabular-nums"><%= number @registry.total_threads %></div>
        </div>
        <div class="bg-white p-4 dark:bg-slate-900">
          <div class="text-xs uppercase tracking-wide text-slate-500">Busy</div>
          <div class="mt-1 text-xl font-semibold tabular-nums"><%= number @registry.busy_threads %></div>
        </div>
        <div class="bg-white p-4 dark:bg-slate-900">
          <div class="text-xs uppercase tracking-wide text-slate-500">Utilization</div>
          <div class="mt-1 text-xl font-semibold tabular-nums"><%= @registry.utilization %>%</div>
        </div>
      </div>

      <ul class="divide-y divide-slate-100 text-sm dark:divide-slate-800/70">
        <% @registry.processes.first(5).each do |process| %>
          <li class="flex items-center justify-between gap-3 px-4 py-2.5">
            <div class="min-w-0">
              <%= link_to process.name, process_path(process), class: "font-medium hover:underline" %>
              <div class="text-xs text-slate-400"><%= process.kind %> · <%= process.hostname %></div>
            </div>
            <div class="text-right text-xs text-slate-500">
              <%= @registry.alive?(process) ? badge("alive", color: "emerald") : badge("no heartbeat", color: "rose") %>
              <div class="mt-1"><%= relative_time process.last_heartbeat_at %></div>
            </div>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="<%= card_classes %>">
      <div class="<%= card_header_classes %>">
        <h2 class="text-sm font-semibold">Latest failures</h2>
        <%= link_to "All failed jobs", jobs_path(status: "failed"), class: "text-sm text-slate-500 underline-offset-2 hover:underline" %>
      </div>

      <% if @recent_failures.any? %>
        <ul class="divide-y divide-slate-100 dark:divide-slate-800/70">
          <% @recent_failures.each do |job| %>
            <li class="flex flex-wrap items-baseline justify-between gap-2 px-4 py-3">
              <div class="min-w-0">
                <%= link_to job.class_name, job_path(job), class: "text-sm font-medium hover:underline" %>
                <p class="mt-0.5 truncate font-mono text-xs text-rose-600 dark:text-rose-400">
                  <%= failed_error_class(job.failed_execution) %>: <%= truncate(failed_error_message(job.failed_execution), length: 140) %>
                </p>
              </div>
              <span class="text-xs text-slate-500"><%= relative_time job.failed_execution&.created_at %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render "solid_queue_panel/shared/empty_state", title: "No failures", description: "Nothing has blown up recently.", icon_name: "check-circle" %>
      <% end %>
    </div>
  </div>
</div>
