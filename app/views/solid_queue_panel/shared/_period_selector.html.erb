<%# locals: (current:) %>
<div class="inline-flex overflow-hidden rounded-md ring-1 ring-inset ring-slate-300 text-sm dark:ring-slate-700">
  <% time_periods.each do |period| %>
    <%= link_to period.label, url_with(period: period.hours), class: class_names(
          "px-2.5 py-1 transition",
          current == period ? "bg-slate-900 text-white dark:bg-white dark:text-slate-900" : "text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"
        ) %>
  <% end %>
</div>
