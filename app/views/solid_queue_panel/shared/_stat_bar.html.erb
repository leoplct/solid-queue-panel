<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-7">
  <%= render "solid_queue_panel/shared/stat_tile", label: "In progress", value: overview.in_progress,
             color: "text-blue-600 dark:text-blue-400", path: jobs_path(status: "in_progress") %>
  <%= render "solid_queue_panel/shared/stat_tile", label: "Queued", value: overview.queued,
             color: "text-indigo-600 dark:text-indigo-400", path: jobs_path(status: "queued") %>
  <%= render "solid_queue_panel/shared/stat_tile", label: "Scheduled", value: overview.scheduled,
             color: "text-violet-600 dark:text-violet-400", path: jobs_path(status: "scheduled") %>
  <%= render "solid_queue_panel/shared/stat_tile", label: "Blocked", value: overview.blocked,
             color: "text-amber-600 dark:text-amber-400", path: jobs_path(status: "blocked") %>
  <%= render "solid_queue_panel/shared/stat_tile", label: "Failed", value: overview.failed,
             color: "text-rose-600 dark:text-rose-400", path: jobs_path(status: "failed") %>
  <%= render "solid_queue_panel/shared/stat_tile", label: "Finished 24h", value: overview.finished,
             color: "text-emerald-600 dark:text-emerald-400", path: jobs_path(status: "finished") %>
  <%= render "solid_queue_panel/shared/stat_tile", label: "Latency", value: duration_in_words(overview.latency),
             color: "text-slate-700 dark:text-slate-200", path: queues_path,
             hint: "Oldest job waiting in a queue" %>
</div>
