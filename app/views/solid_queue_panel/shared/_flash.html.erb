<% flash.each do |level, message| %>
  <div class="mb-4 flex items-start gap-2 rounded-lg px-4 py-3 text-sm ring-1 ring-inset <%= flash_classes(level) %>" role="status">
    <%= icon level.to_s == "alert" ? "exclamation-circle" : "check-circle", css_class: "size-5 shrink-0" %>
    <span><%= message %></span>
  </div>
<% end %>
