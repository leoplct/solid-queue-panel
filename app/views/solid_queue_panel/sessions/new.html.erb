<% content_for :title, "Sign in" %>

<div class="mb-6 flex items-center justify-center gap-2">
  <span class="flex size-9 items-center justify-center rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-900">
    <%= icon "bolt", css_class: "size-5" %>
  </span>
  <span class="text-lg font-semibold"><%= panel_name %></span>
</div>

<div class="<%= card_classes %> p-6">
  <h1 class="text-base font-semibold">Sign in</h1>
  <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
    Use the credentials configured in <code>config/initializers/solid_queue_panel.rb</code>.
  </p>

  <% if flash[:alert] %>
    <p class="mt-4 flex items-center gap-2 rounded-lg px-3 py-2 text-sm ring-1 ring-inset <%= flash_classes(:alert) %>">
      <%= icon "exclamation-circle", css_class: "size-4 shrink-0" %> <%= flash[:alert] %>
    </p>
  <% end %>

  <%= form_with url: login_path, method: :post, class: "mt-5 space-y-4" do |form| %>
    <%= hidden_field_tag :return_to, params[:return_to] %>

    <div>
      <%= form.label :username, class: "block text-sm font-medium" %>
      <%= form.text_field :username, autocomplete: "username", autofocus: true, required: true,
                          class: "mt-1 block w-full rounded-md border-0 bg-white px-3 py-2 text-sm text-slate-900 ring-1 ring-inset ring-slate-300 focus:outline-none focus:ring-2 focus:ring-slate-900 dark:bg-slate-900 dark:text-slate-100 dark:ring-slate-700 dark:focus:ring-white" %>
    </div>

    <div>
      <%= form.label :password, class: "block text-sm font-medium" %>
      <%= form.password_field :password, autocomplete: "current-password", required: true,
                              class: "mt-1 block w-full rounded-md border-0 bg-white px-3 py-2 text-sm text-slate-900 ring-1 ring-inset ring-slate-300 focus:outline-none focus:ring-2 focus:ring-slate-900 dark:bg-slate-900 dark:text-slate-100 dark:ring-slate-700 dark:focus:ring-white" %>
    </div>

    <button type="submit" class="<%= button_classes(:primary) %> w-full py-2">Sign in</button>
  <% end %>
</div>

<p class="mt-4 text-center text-xs text-slate-400">
  Your browser stays signed in for <%= panel_configuration.session_duration.inspect %>.
</p>
