<% content_for :title, "Job ##{@job.id}" %>
<% status = job_status(@job) %>

<div class="space-y-4">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-xl font-semibold"><%= @job.class_name %></h1>
        <%= job_status_badge @job, status: status %>
      </div>
      <p class="mt-1 text-sm text-slate-500">
        Job #<%= @job.id %> · enqueued <%= relative_time @job.created_at %> in
        <%= queue_link @job.queue_name, class: "underline-offset-2 hover:underline" %>
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <%= link_to jobs_path(status: status), class: button_classes do %>
        <%= icon "chevron-left", css_class: "size-4" %> Back to jobs
      <% end %>

      <% unless read_only? %>
        <% if status == :failed %>
          <%= button_to "Retry", retry_job_path(@job), method: :post, class: button_classes(:primary), form_class: "contents" %>
        <% end %>

        <% if status == :scheduled %>
          <%= button_to "Run now", dispatch_now_job_path(@job), method: :post, class: button_classes(:primary), form_class: "contents" %>
        <% end %>

        <% unless status == :in_progress %>
          <%= button_to "Discard", job_path(@job), method: :delete, class: button_classes(:danger), form_class: "contents",
                        form: { data: { sqd_confirm: "Discard job ##{@job.id}?" } } %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @failed_execution %>
    <div class="<%= card_classes %> border-l-4 border-l-rose-500">
      <div class="<%= card_header_classes %>">
        <h2 class="flex items-center gap-2 text-sm font-semibold text-rose-700 dark:text-rose-300">
          <%= icon "exclamation-triangle", css_class: "size-4" %>
          <%= failed_error_class(@failed_execution) %>
        </h2>
        <span class="text-xs text-slate-500">failed <%= relative_time @failed_execution.created_at %></span>
      </div>

      <div class="space-y-3 p-4">
        <p class="font-mono text-sm text-slate-800 dark:text-slate-200"><%= failed_error_message(@failed_execution) %></p>

        <% if failed_backtrace(@failed_execution).any? %>
          <details class="group">
            <summary class="cursor-pointer text-sm font-medium text-slate-600 hover:text-slate-900 dark:text-slate-300">
              Backtrace (<%= failed_backtrace(@failed_execution).size %> lines)
            </summary>
            <pre class="mt-2 max-h-96 overflow-auto rounded-lg bg-slate-900 p-3 font-mono text-xs leading-relaxed text-slate-200"><%= failed_backtrace(@failed_execution).join("\n") %></pre>
          </details>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="<%= card_classes %>">
      <div class="<%= card_header_classes %>"><h2 class="text-sm font-semibold">Details</h2></div>
      <dl class="divide-y divide-slate-100 text-sm dark:divide-slate-800/70">
        <%= render "solid_queue_panel/jobs/detail", label: "Active Job id", value: @job.active_job_id %>
        <%= render "solid_queue_panel/jobs/detail", label: "Queue", value: @job.queue_name %>
        <%= render "solid_queue_panel/jobs/detail", label: "Priority", value: @job.priority %>
        <%= render "solid_queue_panel/jobs/detail", label: "Attempts", value: job_attempts(@job) %>
        <%= render "solid_queue_panel/jobs/detail", label: "Enqueued at", value: absolute_time(@job.created_at) %>
        <%= render "solid_queue_panel/jobs/detail", label: "Scheduled at", value: absolute_time(job_due_at(@job)) %>
        <%= render "solid_queue_panel/jobs/detail", label: "Finished at", value: absolute_time(@job.finished_at) %>
        <% if (runtime = job_runtime(@job)) %>
          <%= render "solid_queue_panel/jobs/detail", label: status == :in_progress ? "Running for" : "Total time", value: duration_in_words(runtime) %>
        <% end %>
        <% if @job.concurrency_key.present? %>
          <%= render "solid_queue_panel/jobs/detail", label: "Concurrency key", value: @job.concurrency_key %>
        <% end %>
        <% if (process = @job.claimed_execution&.process) %>
          <div class="flex gap-4 px-4 py-2.5">
            <dt class="w-40 shrink-0 text-slate-500">Worker</dt>
            <dd><%= link_to process.name, process_path(process), class: "hover:underline" %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <div class="<%= card_classes %>">
      <div class="<%= card_header_classes %>">
        <h2 class="text-sm font-semibold">Active Job payload</h2>
      </div>
      <pre class="max-h-96 overflow-auto p-4 font-mono text-xs leading-relaxed text-slate-700 dark:text-slate-300"><%= job_payload(@job) %></pre>
    </div>
  </div>
</div>
