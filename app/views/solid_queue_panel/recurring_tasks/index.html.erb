<% content_for :title, "Recurring tasks" %>

<div class="<%= card_classes %>">
  <div class="<%= card_header_classes %>">
    <h2 class="text-sm font-semibold">Recurring tasks <span class="ml-1 text-slate-400">(<%= @tasks.size %>)</span></h2>
    <p class="text-xs text-slate-500">Static tasks come from <code>config/recurring.yml</code>, dynamic ones are created at runtime.</p>
  </div>

  <% if @tasks.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800">
        <thead class="bg-slate-50 dark:bg-slate-900/60">
          <tr>
            <th scope="col" class="<%= table_header_classes %>">Task</th>
            <th scope="col" class="<%= table_header_classes %>">Schedule</th>
            <th scope="col" class="<%= table_header_classes %>">Queue</th>
            <th scope="col" class="<%= table_header_classes %>">Last run</th>
            <th scope="col" class="<%= table_header_classes %>">Next run</th>
            <th scope="col" class="<%= table_header_classes %>"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>

        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/70">
          <% @tasks.each do |task| %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-4 py-2.5">
                <div class="flex items-center gap-2">
                  <%= link_to task.key, recurring_task_path(task.key), class: "text-sm font-medium hover:underline" %>
                  <%= badge(task.static? ? "static" : "dynamic", color: task.static? ? "slate" : "violet") %>
                </div>
                <div class="mt-0.5 truncate font-mono text-xs text-slate-400"><%= recurring_target(task) %></div>
              </td>
              <td class="<%= table_cell_classes %> font-mono text-xs"><%= task.schedule %></td>
              <td class="<%= table_cell_classes %>"><%= task.queue_name.presence || "—" %></td>
              <td class="<%= table_cell_classes %>"><%= relative_time task.last_enqueued_time %></td>
              <td class="<%= table_cell_classes %>"><%= relative_time recurring_next_time(task) %></td>
              <td class="px-4 py-2.5 text-right">
                <%= link_to recurring_task_path(task.key), class: button_classes, title: "Task details" do %>
                  <%= icon "arrow-right", css_class: "size-4" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "solid_queue_panel/shared/empty_state",
               title: "No recurring task",
               description: "Add tasks to config/recurring.yml and run a Solid Queue scheduler to see them here.",
               icon_name: "arrow-path" %>
  <% end %>
</div>
